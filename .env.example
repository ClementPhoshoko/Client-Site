# Resend API key. Keep this secret; never prefix it with VITE_.
RESEND_API_KEY=re_your_api_key

# Must be a sender address on a domain verified in Resend.
RESEND_FROM_EMAIL=PHM Website <website@your-verified-domain.co.za>
CONTACT_TO_EMAIL=info@phmps.co.za

# Public website origin used for the logo in contact notification emails.
SITE_URL=https://phmps.co.za
